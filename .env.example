# MerchantOS local development. Copy to .env and never commit .env.
# No Shopify, LLM, or AWS production credentials belong here.

APP_ENV=dev
APP_NAME=merchantos
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres (Compose). POSTGRES_USER is a superuser and bypasses RLS even with FORCE.
# Use this owner URL for Alembic and test TRUNCATE. Staging/production api+worker
# MUST use a non-superuser, non-BYPASSRLS role (local equivalent: merchantos_app).
# See ADR 0018. Do not point migrate at merchantos_app.
DATABASE_URL=postgresql://merchantos:merchantos@localhost:5432/merchantos

# Redis (Compose)
REDIS_URL=redis://localhost:6379/0

# Local SQS (ElasticMQ). DEVELOPMENT ONLY — not used as production AWS.
# Leave unset to skip queue readiness. Dummy keys are required by the AWS SDK
# and are not secrets.
SQS_ENDPOINT_URL=http://localhost:9324
SQS_REGION=us-east-1
SQS_QUEUE_NAME=merchantos-dev-jobs
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Shopify (standalone app). Never commit real values. Client secret is server-only.
# Generate TOKEN_ENCRYPTION_KEY:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/auth/shopify/callback
API_PUBLIC_BASE_URL=http://localhost:8000
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=local-v1
SESSION_TTL_HOURS=72

# LLM. Leave provider=fake for local/CI. Never commit a real key.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OAuth/webhooks require a public HTTPS URL (ngrok or Cloudflare Tunnel) for a real shop install.
