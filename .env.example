# MerchantOS local development. Copy to .env and never commit .env.
# No Shopify, LLM, or AWS production credentials belong here.

APP_ENV=dev
APP_NAME=merchantos
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres (Compose)
DATABASE_URL=postgresql://merchantos:merchantos@localhost:5432/merchantos

# Redis (Compose)
REDIS_URL=redis://localhost:6379/0

# Local SQS (ElasticMQ). DEVELOPMENT ONLY — not used as production AWS.
# Leave unset to skip queue readiness. Dummy keys are required by the AWS SDK
# and are not secrets.
SQS_ENDPOINT_URL=http://localhost:9324
SQS_REGION=us-east-1
SQS_QUEUE_NAME=merchantos-dev-jobs
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
